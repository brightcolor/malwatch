# ISPConfig extension: malwatch
# Format: action:source:target
#   c = copy, s = symlink, d = create directory
#   source is relative to the extension directory,
#   target relative to /usr/local/ispconfig.

# --- Interface -------------------------------------------------------------
# The extension adds its own Security module. Each operator must have the
# module name written to sys_user.modules to see the section; the installer
# does this automatically via grant_module(), avoiding the need to touch
# core tables directly. This is cleaner than joining an existing module
# through menu.d, because the module gets its own configuration file.
#
# Interface files are COPIED, not symlinked: the pages use ISPConfig's own
# convention of relative includes (require_once '../../lib/config.inc.php'),
# and behind a symlink PHP resolves those against the extension directory,
# where interface/lib does not exist.
c:interface/module.conf.php:interface/web/security/lib/module.conf.php

c:interface/malwatch_site_list.php:interface/web/security/malwatch_site_list.php
c:interface/malwatch_progress.php:interface/web/security/malwatch_progress.php
c:interface/malwatch_site_show.php:interface/web/security/malwatch_site_show.php
c:interface/malwatch_site_edit.php:interface/web/security/malwatch_site_edit.php
c:interface/malwatch_finding_list.php:interface/web/security/malwatch_finding_list.php
c:interface/malwatch_scan_list.php:interface/web/security/malwatch_scan_list.php
c:interface/malwatch_config_edit.php:interface/web/security/malwatch_config_edit.php

c:interface/list/malwatch_finding.list.php:interface/web/security/list/malwatch_finding.list.php
c:interface/list/malwatch_scan.list.php:interface/web/security/list/malwatch_scan.list.php
c:interface/form/malwatch_site.tform.php:interface/web/security/form/malwatch_site.tform.php
c:interface/form/malwatch_config.tform.php:interface/web/security/form/malwatch_config.tform.php

c:interface/templates/malwatch_site_list.htm:interface/web/security/templates/malwatch_site_list.htm
c:interface/templates/malwatch_site_show.htm:interface/web/security/templates/malwatch_site_show.htm
c:interface/templates/malwatch_site_edit.htm:interface/web/security/templates/malwatch_site_edit.htm
c:interface/templates/malwatch_config_edit.htm:interface/web/security/templates/malwatch_config_edit.htm
c:interface/templates/malwatch_finding_list.htm:interface/web/security/templates/malwatch_finding_list.htm
c:interface/templates/malwatch_scan_list.htm:interface/web/security/templates/malwatch_scan_list.htm

c:interface/lang/de_malwatch.lng:interface/web/security/lib/lang/de_malwatch.lng
c:interface/lang/en_malwatch.lng:interface/web/security/lib/lang/en_malwatch.lng
c:interface/lang/de_malwatch_site.lng:interface/web/security/lib/lang/de_malwatch_site.lng
c:interface/lang/en_malwatch_site.lng:interface/web/security/lib/lang/en_malwatch_site.lng
c:interface/lang/de_malwatch_config.lng:interface/web/security/lib/lang/de_malwatch_config.lng
c:interface/lang/en_malwatch_config.lng:interface/web/security/lib/lang/en_malwatch_config.lng
c:interface/lang/de_malwatch_finding_list.lng:interface/web/security/lib/lang/de_malwatch_finding_list.lng
c:interface/lang/en_malwatch_finding_list.lng:interface/web/security/lib/lang/en_malwatch_finding_list.lng
c:interface/lang/de_malwatch_scan_list.lng:interface/web/security/lib/lang/de_malwatch_scan_list.lng
c:interface/lang/en_malwatch_scan_list.lng:interface/web/security/lib/lang/en_malwatch_scan_list.lng

# --- Server ----------------------------------------------------------------
# Module and plugin are symlinked so an update replaces them atomically.
s:server/mods/malwatch_module.inc.php:server/mods-available/malwatch_module.inc.php
s:server/mods/malwatch_module.inc.php:server/mods-enabled/malwatch_module.inc.php
s:server/plugins/malwatch_plugin.inc.php:server/plugins-available/malwatch_plugin.inc.php
s:server/plugins/malwatch_plugin.inc.php:server/plugins-enabled/malwatch_plugin.inc.php

# Service classes are COPIED. app::uses() and app::load() skip a symlink
# unless DEVSYSTEM is on, and on a production install it is not: the class
# would silently never load and every call on it would be a fatal.
c:server/lib/classes/malwatch_helper.inc.php:server/lib/classes/malwatch_helper.inc.php
c:server/lib/classes/malwatch_runner.inc.php:server/lib/classes/malwatch_runner.inc.php
c:server/lib/classes/malwatch_ingest.inc.php:server/lib/classes/malwatch_ingest.inc.php
c:server/lib/classes/malwatch_actions.inc.php:server/lib/classes/malwatch_actions.inc.php
c:server/lib/classes/cron.d/560-malwatch.inc.php:server/lib/classes/cron.d/560-malwatch.inc.php

c:server/conf/malwatch_notification_de.txt:server/conf/malwatch_notification_de.txt
c:server/conf/malwatch_notification_en.txt:server/conf/malwatch_notification_en.txt
c:server/conf/malwatch_client_notification_de.txt:server/conf/malwatch_client_notification_de.txt
c:server/conf/malwatch_client_notification_en.txt:server/conf/malwatch_client_notification_en.txt

# Diagnostic tools. Not linked into the ISPConfig tree; they are run from
# the extension directory when something needs checking.
#   php tests/render_pages.php

