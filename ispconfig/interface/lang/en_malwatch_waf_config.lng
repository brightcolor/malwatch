$wb['waf_ban_window_minutes_hint_txt'] = 'The points of an address are added up over this period.';
$wb['waf_ban_logged_in_percent_txt'] = 'Logged-in requests count at';
$wb['waf_ban_logged_in_percent_hint_txt'] = 'Points from requests with a logged-in WordPress session count at this share, so editors can keep working with page builders and uploads in the backend. Login and XML-RPC always count in full. The login cookie can be forged: at 10 percent an address with a forged cookie needs ten times the points, at 0 it is blocked only for attacks on login or XML-RPC. 100 switches the discount off.';
