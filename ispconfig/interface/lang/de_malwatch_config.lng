$wb['auto_head_txt'] = 'Was soll bei den geplanten Prüfungen automatisch passieren?';
// Frueher stand hier unbedingt "Sie bekommen eine E-Mail mit der Liste.".
// Verschickt wird sie nur, wenn die Website auf Benachrichtigung steht UND
// der schlimmste neue Fund deren Stufe erreicht (Vorgabe: hoch) - siehe
// malwatch_actions::run(). Der Satz stand auf genau dem Bildschirm, auf dem
// entschieden wird, ob nachts von allein Dateien verschwinden.
$wb['auto_intro_txt'] = 'Alles, was automatisch verschoben wird, wird vorher gesichert und lässt sich jederzeit zurückholen. Eine E-Mail mit der Liste bekommen Sie, wenn die betroffene Website auf Benachrichtigung eingestellt ist und der Fund deren Stufe erreicht. In der Quarantäne steht die Liste in jedem Fall.';
$wb['auto_scope_txt'] = 'Gilt für Funde, die neu hinzukommen. Was schon in der Liste steht, bleibt liegen — das haben Sie gesehen und stehen gelassen.';

$wb['auto_none_name_txt'] = 'Nichts anfassen';
$wb['auto_none_desc_txt'] = 'Nur melden. Jede Datei wartet darauf, dass Sie entscheiden. Die sicherste Einstellung — und die, bei der eine Hintertür so lange erreichbar bleibt, bis Sie hinsehen.';
$wb['auto_safe_name_txt'] = 'Eindeutige Schädlinge entfernen';
$wb['auto_safe_tag_txt'] = 'empfohlen';
// Frueher: "Diese Pruefungen haben in ueber 200.000 unbescholtenen Dateien
// keinen einzigen Fehlalarm erzeugt." Zwei Ungenauigkeiten, beide zugunsten
// des Satzes: gemessen wurden 193.888 Dateien, und die Messung deckt die zwei
// groessten dieser Pruefungen ab, nicht alle, die die Zeile darunter als
// "%s von %s Pruefungen" zaehlt. Der Satz nennt jetzt beides beim Namen. Er
// vergleicht sich weiterhin nicht mit "Alles Kritische entfernen": keine der
// beiden Mengen enthaelt die andere (767 gegenueber 472 von 1511 offenen
// Funddateien auf dem Livesystem gemessen).
$wb['auto_safe_desc_txt'] = 'Nur die Funde, bei denen es nichts zu entscheiden gibt: Hintertüren, Nachlader, verschleierte Funktionsnamen. Die beiden häufigsten dieser Prüfungen liefen über 193.888 unbescholtene Dateien, ohne einen einzigen Fehlalarm.';
$wb['auto_critical_name_txt'] = 'Alles Kritische entfernen';
// Frueher stand hier "erwischt mehr [als eindeutige Schaedlinge]" - eine
// Messung gegen echte Funde widerlegt das (siehe progress.md): auto_safe ist
// keine Teilmenge von critical, keins der beiden Merkmale enthaelt das
// andere. Der Text beschreibt jetzt nur noch, was "kritisch" bedeutet, ohne
// die beiden Mengen zu vergleichen.
$wb['auto_critical_desc_txt'] = 'Jeder Fund der höchsten Stufe — unabhängig davon, welche Prüfung ihn gemeldet hat. Das kann auch eine Datei treffen, die ein Plugin zum Laufen braucht.';
