$wb['hashlookup_txt'] = 'Datenbank bekannter Dateien fragen';
$wb['hashlookup_hint_txt'] = 'Dateien mit Fund, die kein anderer Abgleich bestätigt, schlägt der Scanner in der Datenbank unter der Adresse unten nach; eine dort bekannte, gewöhnliche Datei veröffentlichter Software verliert ihren Fund. An den Dienst gehen ausschließlich die SHA-1-Summen dieser Dateien. Standardmäßig aus.';
$wb['hashlookup_url_txt'] = 'Adresse der Datenbank';
$wb['hashlookup_url_hint_txt'] = 'Die https-Adresse eines Dienstes mit der Schnittstelle von CIRCL hashlookup, etwa https://hashlookup.circl.lu. Die Adresse steht auf der Befehlszeile des Scanners und enthält deshalb keine Anmeldedaten.';
$wb['hashlookup_url_error_regex'] = 'Adresse der Datenbank: Erlaubt ist eine https-Adresse wie https://hashlookup.circl.lu, auf Wunsch mit Port und Pfad, ohne Benutzer und Passwort. Bitte die Adresse anpassen und erneut speichern.';
$wb['keep_job_days_txt'] = 'Erledigte Aufträge behalten (Tage)';
