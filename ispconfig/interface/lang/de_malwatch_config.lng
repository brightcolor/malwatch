$wb['vanished_check_rows_txt'] = 'Funde je Stunde auf fehlende Dateien prüfen';
$wb['vanished_check_rows_hint_txt'] = 'So viele offene Funde prüft der Server je Stunde darauf, ob ihre Datei noch da ist; ist sie weg, gilt der Fund als behoben. Das hält vor allem die Funde von Websites aktuell, die nicht mehr geprüft werden. 0 schaltet das ab. Erlaubt: 0 bis 10000.';
$wb['vanished_check_rows_error_range'] = 'Funde je Stunde auf fehlende Dateien prüfen: Erlaubt sind ganze Zahlen von 0 bis 10000. Bitte den Wert anpassen und erneut speichern.';
