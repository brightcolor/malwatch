// Checking against the vendors and the hourly housekeeping (0.41.0)
$wb['verify_head_txt'] = 'Checking against the vendors';
$wb['verify_intro_txt'] = 'How the scanner tells a file of the vendor from a finding. The values go to the scanner with every scan.';
$wb['modified_exts_txt'] = 'Extensions for deviations';
$wb['modified_exts_hint_txt'] = 'When a file of WordPress, a plugin or a theme differs from the original of its vendor, the scanner reports it for these extensions: for everything PHP, the web server or a browser runs. Extensions without a dot, separated by commas. Allowed: 1 to 40 extensions of at most 12 lower case letters or digits each.';
$wb['modified_exts_error_regex'] = 'Extensions for deviations: 1 to 40 extensions of at most 12 lower case letters or digits each are allowed, separated by commas, such as php,js,html. Please adjust the list and save again.';
$wb['script_hosts_txt'] = 'Allowed script hosts';
$wb['script_hosts_hint_txt'] = 'A script written by document.write that loads from one of these hosts counts as harmless, such as the old Google Analytics snippet. Host names separated by commas, without https:// and without a path. Empty allows scripts of the website itself only. Allowed: up to 32 hosts of at most 100 characters each.';
$wb['script_hosts_error_regex'] = 'Allowed script hosts: up to 32 host names like www.example.org of at most 100 characters each are allowed, separated by commas, without https:// and without a path. Please adjust the list and save again.';
$wb['verify_composer_txt'] = 'Check Composer packages';
$wb['verify_composer_hint_txt'] = 'The scanner compares a file with a finding in a Composer package (vendor/) with the original archive of the package. If it matches, the finding goes. The server loads the archives from the hosts for archives.';
$wb['verify_originals_txt'] = 'Check original files';
$wb['verify_originals_hint_txt'] = 'The scanner compares a differing script file of a plugin or theme from wordpress.org with the file of its vendor: an inserted block stays a finding, a file rebuilt throughout counts as the work of the vendor. The file comes from the SVN of wordpress.org.';
$wb['verify_hosts_txt'] = 'Hosts for archives';
$wb['verify_hosts_hint_txt'] = 'The server loads the original archives of Composer packages from these hosts. Host names separated by commas, without https:// and without a path; empty switches loading archives off. Allowed: up to 16 hosts of at most 100 characters each.';
$wb['verify_hosts_error_regex'] = 'Hosts for archives: up to 16 host names like codeload.github.com of at most 100 characters each are allowed, separated by commas, without https:// and without a path. Please adjust the list and save again.';
$wb['verify_max_downloads_txt'] = 'Downloads per scan';
$wb['verify_max_downloads_hint_txt'] = 'A scan loads at most this many archives and original files. Whatever was loaded once comes from the cache in the working directory afterwards. Allowed: 1 to 1000.';
$wb['verify_max_downloads_error_range'] = 'Downloads per scan: whole numbers from 1 to 1000 are allowed. Please adjust the value and save again.';
$wb['verify_max_mb_txt'] = 'Size per download (MB)';
$wb['verify_max_mb_hint_txt'] = 'The scanner skips larger archives and files; unpacked, an archive may take ten times as much. Allowed: 1 to 500.';
$wb['verify_max_mb_error_range'] = 'Size per download: whole numbers from 1 to 500 MB are allowed. Please adjust the value and save again.';
$wb['verify_timeout_txt'] = 'Waiting time per download (seconds)';
$wb['verify_timeout_hint_txt'] = 'The scanner waits this long for an archive or a file; then the download counts as failed and the finding stays. Allowed: 1 to 600.';
$wb['verify_timeout_error_range'] = 'Waiting time per download: whole numbers from 1 to 600 seconds are allowed. Please adjust the value and save again.';
$wb['verify_retry_hours_txt'] = 'Retry after (hours)';
$wb['verify_retry_hours_hint_txt'] = 'The scanner asks again for an archive that could not be loaded only after this many hours. 0 tries with every scan. Allowed: 0 to 720.';
$wb['verify_retry_hours_error_range'] = 'Retry after: whole numbers from 0 to 720 hours are allowed. Please adjust the value and save again.';
$wb['hashlookup_txt'] = 'Ask a database of known files';
$wb['hashlookup_hint_txt'] = 'The scanner looks up files with a finding that no other check confirms in the database at the address below; an ordinary file of published software known there loses its finding. Only the SHA-1 sums of these files go to the service. Off by default.';
$wb['hashlookup_url_txt'] = 'Address of the database';
$wb['hashlookup_url_hint_txt'] = 'The https address of a service with the interface of CIRCL hashlookup, such as https://hashlookup.circl.lu. The address stands on the command line of the scanner and so carries no login.';
$wb['hashlookup_url_error_regex'] = 'Address of the database: an https address like https://hashlookup.circl.lu is allowed, with a port and a path if need be, without user and password. Please adjust the address and save again.';
$wb['keep_job_days_txt'] = 'Keep finished jobs (days)';
$wb['keep_job_days_hint_txt'] = 'Finished and failed jobs stay this long with their log. Allowed: 1 to 3650.';
$wb['keep_job_days_error_range'] = 'Keep finished jobs: whole numbers from 1 to 3650 days are allowed. Please adjust the value and save again.';
$wb['keep_fixed_days_txt'] = 'Keep fixed findings (days)';
$wb['keep_fixed_days_hint_txt'] = 'A fixed finding stays in the list this long after the last scan that saw it. Allowed: 1 to 3650.';
$wb['keep_fixed_days_error_range'] = 'Keep fixed findings: whole numbers from 1 to 3650 days are allowed. Please adjust the value and save again.';
$wb['vanished_check_rows_txt'] = 'Findings checked for missing files per hour';
$wb['vanished_check_rows_hint_txt'] = 'The server checks this many open findings per hour for whether their file is still there; if it is gone, the finding counts as fixed. This mostly keeps the findings of websites current that are no longer scanned. 0 switches it off. Allowed: 0 to 10000.';
$wb['vanished_check_rows_error_range'] = 'Findings checked for missing files per hour: whole numbers from 0 to 10000 are allowed. Please adjust the value and save again.';
$wb['housekeeping_minute_txt'] = 'Minute of the hourly housekeeping';
$wb['housekeeping_minute_hint_txt'] = 'At this minute of every hour the server clears old scans, jobs, findings and views. Allowed: 0 to 59.';
$wb['housekeeping_minute_error_range'] = 'Minute of the hourly housekeeping: whole numbers from 0 to 59 are allowed. Please adjust the value and save again.';
