$wb['view_marks_error_range'] = 'Marked places per rule: whole numbers from 1 to 200 are allowed. Please adjust the value and save again.';
$wb['view_budget_error_range'] = 'Code per report: whole numbers from 1 to 512 MiB are allowed. Please adjust the value and save again.';
$wb['view_keep_days_error_range'] = 'Keep views: whole numbers from 1 to 365 days are allowed. Please adjust the value and save again.';
