$wb['default_scan_days_txt'] = 'Days between scans for new websites';
$wb['default_scan_days_hint_txt'] = 'Websites without settings of their own get this interval as soon as the scanner finds them; their first scan falls at a random moment within it, so many new websites spread over that time. Websites with settings of their own keep their interval. With 0, new websites get no schedule.';
$wb['default_excludes_txt'] = 'Paths skipped everywhere';
$wb['default_excludes_hint_txt'] = 'One pattern per line, applied on top of the patterns of each website.';
$wb['scan_max_age_txt'] = 'Only files from the last days';
$wb['scan_max_age_hint_txt'] = '0 scans every file. Only applies to websites without their own value.';
$wb['upload_dirs_txt'] = 'Folders for uploaded files';
$wb['upload_dirs_hint_txt'] = 'Folder names separated by commas; case matters. A PHP file, shell script or Linux program below one of these folders is reported on its own. Only list folders a CMS fills with uploads alone.';

$wb['limits_head_txt'] = 'Limits';
$wb['max_parallel_txt'] = 'Concurrent scans';
$wb['max_parallel_hint_txt'] = 'Several scans at once put a noticeable load on the disk. On a server with many websites, stay at 1 or 2.';
$wb['job_timeout_hours_txt'] = 'Abort after hours';
$wb['job_timeout_hours_hint_txt'] = 'A scan that runs longer is stopped by the server and gives up its slot. Allowed: 1 to 168.';
$wb['keep_scans_txt'] = 'Scans kept per website';
$wb['keep_scans_hint_txt'] = 'This many of the latest scans of a website stay with their numbers; the server clears older ones every hour. Allowed: 1 to 1000.';
$wb['poll_seconds_txt'] = 'Progress refresh (seconds)';
$wb['poll_seconds_hint_txt'] = 'How often the overview and the page of a website ask how far a running scan has come. Smaller values show the progress more smoothly; each check is one request to the panel.';
$wb['use_clamav_txt'] = 'Use ClamAV as well';
$wb['use_clamav_hint_txt'] = 'Only takes effect when clamdscan or clamscan is installed.';
$wb['auto_update_signatures_txt'] = 'Update signatures daily';

$wb['vuln_head_txt'] = 'Known vulnerabilities';
$wb['vuln_intro_txt'] = 'For every detected piece of software the scanner asks public databases which security flaws are known for exactly that version: WPVulnerability and wordpress.org for WordPress with its plugins and themes, the Joomla Security Centre for Joomla, OSV for Drupal, TYPO3, phpMyAdmin, Contao, Shopware, MediaWiki and Magento 2. Each answer is kept for a day.';
$wb['vuln_scan_txt'] = 'Look up known vulnerabilities';
$wb['vuln_scan_hint_txt'] = 'WPVulnerability and WPScan receive the name and version of every plugin, theme and WordPress core. OSV is downloaded as a whole and searched on the server.';
$wb['wpscan_token_txt'] = 'WPScan API token';
$wb['wpscan_token_hint_txt'] = 'Optional. With a token the scanner asks WPScan as well. The free plan allows 25 requests a day, which is why these answers are kept for a week. According to WPScan, using the data in a service for customers requires an enterprise plan. A stored token only shows as a placeholder; leave the field empty to keep it.';
$wb['wpscan_token_stored_txt'] = 'Token stored';
$wb['wpscan_token_remove_txt'] = 'Remove the stored token';

$wb['count_sites_txt'] = 'Configured websites';
$wb['count_scans_txt'] = 'Scans';
$wb['count_findings_txt'] = 'Open findings';
$wb['last_signature_update_txt'] = 'Signatures';

$wb['auto_head_txt'] = 'What should the scheduled scans do on their own?';
// Used to say "You get an email with the list." unconditionally. It is only
// sent when the website is set to notify AND the worst new finding reaches
// that website's severity level (default: high) - see
// malwatch_actions::run(). The sentence sits on the very screen where it is
// decided whether files disappear on their own at night.
$wb['auto_intro_txt'] = 'Anything moved automatically is backed up first and can be restored at any time. You get an email with the list when the website concerned is set to notify you and the finding reaches the level set there. The list is in quarantine either way.';
$wb['auto_scope_txt'] = 'Applies to findings that are newly added. What is already on the list stays put - you have seen it and left it there.';

$wb['auto_none_name_txt'] = 'Leave everything alone';
$wb['auto_none_desc_txt'] = 'Only report. Every file waits for you to decide. The safest setting - and the one where a backdoor stays reachable for as long as it takes you to look.';
$wb['auto_safe_name_txt'] = 'Remove unambiguous malware';
$wb['auto_safe_tag_txt'] = 'recommended';
// Used to say "These checks have not produced a single false positive across
// more than 200,000 clean files." Two inaccuracies, both in the sentence's
// own favour: 193,888 files were measured, and the measurement covers the
// two biggest of these checks, not all of the ones the line below counts as
// "%s of %s checks". The sentence now names both. It still does not compare
// itself with "Remove everything critical": neither set contains the other
// (767 against 472 out of 1511 open found files, measured on the live
// system).
$wb['auto_safe_desc_txt'] = 'Only the findings that leave nothing to decide: backdoors, downloaders, obfuscated function names. The two most common of these checks ran across 193,888 clean files without a single false positive.';
$wb['auto_critical_name_txt'] = 'Remove everything critical';
// Used to say "catches more [than unambiguous malware]" - a measurement
// against real findings disproves that (see progress.md): auto_safe is not
// a subset of critical, and neither trait contains the other. The text now
// only describes what "critical" means, without comparing the two sets.
$wb['auto_critical_desc_txt'] = 'Every finding of the highest severity - no matter which check reported it. This can also hit a file a plugin needs to run.';
$wb['auto_preset_name_txt'] = 'Custom selection';
$wb['auto_preset_desc_txt'] = 'You decide which checks are allowed to act on their own - and save the selection under a name, so you do not have to make the same choice every time.';

$wb['rule_count_txt'] = '%s of %s checks · would currently affect %s open found files';
$wb['ownlist_head_txt'] = 'Which checks may act on their own?';
$wb['preset_new_hint_txt'] = 'Save the selection under a name first - only then can a scheduled scan use it.';
$wb['rule_finding_count_txt'] = '%s findings';
$wb['show_all_rules_txt'] = 'Show all %s';
$wb['preset_name_label_txt'] = 'Name of the selection';
