// Finding view (0.39.0)
$wb['view_head_txt'] = 'Finding view';
$wb['view_intro_txt'] = 'What the page of a finding shows of the file: the marked places, the capabilities and the code around them. The values go to the scanner with every scan.';
$wb['view_lines_txt'] = 'Whole file up to (lines)';
$wb['view_lines_hint_txt'] = 'Shorter files are shown whole, longer ones in excerpts of at most this many lines. 0 switches the code view off; the capabilities stay. Allowed: 0 to 2000.';
$wb['view_context_txt'] = 'Lines around each place';
$wb['view_context_hint_txt'] = 'An excerpt shows this many lines above and below each marked place. Allowed: 0 to 50.';
$wb['view_line_length_txt'] = 'Characters per line';
$wb['view_line_length_hint_txt'] = 'Longer lines are cut down to the part around the mark; obfuscated code often sits on a single very long line. Allowed: 60 to 2000.';
$wb['view_marks_txt'] = 'Marked places per rule';
$wb['view_marks_hint_txt'] = 'A rule or capability marks at most this many places in one file. Allowed: 1 to 200.';
$wb['view_budget_txt'] = 'Code per report (MiB)';
$wb['view_budget_hint_txt'] = 'All views of one scan hold at most this much code together. Past it, further files keep their capabilities and lose the code, so a badly infected server does not produce a report the panel cannot load. Allowed: 1 to 512.';
$wb['view_keep_days_txt'] = 'Keep views (days)';
